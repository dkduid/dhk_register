# ===== Salin menjadi .env lalu sesuaikan =====
SECRET_KEY=ganti-dengan-string-acak-panjang
DATABASE_URL=postgresql+psycopg2://dhk_user:PASSWORD@localhost:5432/dhk_register
# Bila password mengandung karakter khusus (@ : / # %), tulis dalam URL-encoded (mis. @ menjadi %40).
# Pembuatan otomatis role + database + tabel saat 'DHKRegister.exe --init-db':
AUTO_CREATE_DB=true
# Superuser PostgreSQL: ISI HANYA SAAT --init-db pertama (atau via variabel lingkungan), lalu KOSONGKAN lagi.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
HOST=0.0.0.0
PORT=8443
HTTPS=true
# SSL_CERT=certs/server.crt   (kosong = dibuat self-signed otomatis)
# SSL_KEY=certs/server.key
SESSION_MINUTES=30
MAX_UPLOAD_MB=25
# Admin awal (dipakai hanya saat database kosong). Kosong = dibuat acak & ditampilkan di console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== LDAP / Active Directory =====
LDAP_ENABLED=false
LDAP_SERVER=ldap.kbi.local
LDAP_PORT=389
LDAP_SSL=false
# Template DN bind. AD (UPN): {u}@kbi.co.id   |  OpenLDAP: uid={u},ou=people,dc=kbi,dc=co,dc=id
LDAP_USER_DN={u}@kbi.co.id
LDAP_BASE_DN=dc=kbi,dc=co,dc=id
LDAP_AUTO_PROVISION=false
LDAP_DEFAULT_ROLE=Viewer

# ===== Antivirus (opsional, ClamAV daemon) =====
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# ===== Deteksi serangan =====
BLOCK_ON_ATTACK=true
MAX_FAILED_LOGIN=5
LOCK_MINUTES=15
